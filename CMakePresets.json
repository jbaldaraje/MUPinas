{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-base",
      "hidden": true,
      "description": "Base configuration for native macOS builds",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64",
      "description": "Native macOS Apple Silicon player build (no editor, no control socket) \u2014 full build target, must compile and pass tests",
      "inherits": "macos-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-arm64.cmake",
      "cacheVariables": {
        "ENABLE_EDITOR": "OFF",
        "ENABLE_CONTROL_SOCKET": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64-debug",
      "displayName": "macOS arm64 Debug",
      "configurePreset": "macos-arm64",
      "configuration": "Debug"
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS arm64 Release",
      "configurePreset": "macos-arm64",
      "configuration": "Release"
    }
  ]
}
