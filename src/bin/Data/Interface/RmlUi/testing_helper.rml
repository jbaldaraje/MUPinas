<rml>
<head>
    <title>Local Testing Helper</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="testing_helper.rcss"/>
    <link type="text/template" href="window_shell.rml"/>
</head>
<!-- Layout: centered independent gameplay panel, draggable header, fixed logical width with viewport
     limits. Tabs stay above a scrolling content area; all text and controls use shared dp scaling. -->
<body template="window_shell" data-model="testing_helper">
    <div class="testing-tabs">
        <div class="btn testing-tab" data-class-selected="tab == 0" data-event-click="testing_tab(0)">{{text[1]}}</div>
        <div class="btn testing-tab" data-class-selected="tab == 1" data-event-click="testing_tab(1)">{{text[2]}}</div>
        <div class="btn testing-tab" data-class-selected="tab == 2" data-event-click="testing_tab(2)">{{text[3]}}</div>
        <div class="btn testing-tab" data-class-selected="tab == 3" data-event-click="testing_tab(3)">{{text[4]}}</div>
        <div class="btn testing-tab" data-class-selected="tab == 4" data-event-click="testing_tab(4)">{{text[5]}}</div>
        <div class="btn testing-tab" data-class-selected="tab == 5" data-event-click="testing_tab(5)">{{text[6]}}</div>
    </div>
    <div class="testing-feedback" data-class-pending="busy">{{feedback}}</div>
    <div class="testing-scroll">
        <div class="testing-note" data-if="!available">{{text[47]}}</div>
        <div class="testing-page" data-class-active="tab == 0"><p>{{text[11]}}</p><p class="testing-summary">{{text[70]}}<br/>{{reset_info}}</p><div class="testing-actions"><div class="btn testing-button" data-class-disabled="busy" data-event-click="testing_action('stay')">{{text[9]}}</div><div class="btn testing-button" data-class-disabled="busy" data-event-click="testing_action('lorencia')">{{text[10]}}</div></div></div>
        <div class="testing-page" data-class-active="tab == 1"><p class="testing-summary">{{text[71]}}<br/>{{drop_info}}</p>
            <p class="testing-summary">{{text[54]}}: {{text[67]}}<br/>{{saved}}</p>
            <p class="testing-summary">{{text[55]}}: {{text[68]}}<br/>{{effective}}</p>
            <div class="testing-fields"><label class="testing-field">{{text[12]}}<input class="text-field text-field--numeric" type="text" data-value="xp" maxlength="6"/></label><label class="testing-field">{{text[13]}}<input class="text-field text-field--numeric" type="text" data-value="drop" maxlength="6"/></label><label class="testing-field">{{text[14]}}<input class="text-field text-field--numeric" type="text" id="testing_speed" data-value="speed" maxlength="6"/></label><label class="testing-field">{{text[15]}}<input class="text-field text-field--numeric" type="text" data-value="stat" maxlength="6"/></label></div>
            <div class="testing-actions"><div class="btn testing-button" data-class-disabled="busy || !administrator || !available" data-event-click="testing_action('rates')">{{text[16]}}</div><div class="btn testing-button" data-class-disabled="busy || !administrator || !available" data-event-click="testing_action('caps')">{{text[17]}}</div><div class="btn testing-button" data-class-disabled="busy || !administrator || !available" data-event-click="testing_action('enable')">{{text[18]}}</div><div class="btn testing-button" data-class-disabled="busy || !administrator || !available" data-event-click="testing_action('disable')">{{text[19]}}</div></div>
            <p>{{text[61]}}</p><p>{{text[59]}}</p>
        </div>
        <div class="testing-page" data-class-active="tab == 2"><div class="testing-fields"><label class="testing-field">{{text[64]}}<select class="text-field" data-value="map"><option value="all">{{text[63]}}</option><option data-for="entry : map_options" data-attr-value="entry.value">{{entry.label}}</option></select></label><label class="testing-field">{{text[21]}}<input class="text-field text-field--numeric" type="text" data-value="target" maxlength="6"/></label><label class="testing-field">{{text[22]}}<input class="text-field text-field--numeric" type="text" data-value="group" maxlength="6"/></label><label class="testing-field">{{text[23]}}<input class="text-field text-field--numeric" type="text" data-value="respawn" maxlength="6"/></label><label class="testing-field">{{text[24]}}<input class="text-field text-field--numeric" type="text" data-value="spacing" maxlength="6"/></label></div>
            <div class="testing-actions"><div class="btn testing-button" data-class-disabled="busy || !administrator || !available" data-event-click="testing_action('spots')">{{text[69]}}</div><div class="btn testing-button" data-class-disabled="busy || !administrator || !available" data-event-click="testing_action('preview')">{{text[25]}}</div><div class="btn testing-button" data-class-disabled="busy || !administrator || !available" data-event-click="testing_action('apply')">{{text[26]}}</div><div class="btn testing-button" data-class-disabled="busy || !administrator || !available" data-event-click="testing_action('cleanup')">{{text[27]}}</div></div>
            <p>{{text[28]}}</p><p class="testing-muted">{{text[62]}}</p><div class="testing-record" data-for="row : rows">{{row}}</div>
        </div>
        <div class="testing-page" data-class-active="tab == 3"><div class="testing-fields"><label class="testing-field">{{text[29]}}<input class="text-field text-field--numeric" type="text" data-value="count" maxlength="6"/></label><label class="testing-field">{{text[64]}}<select class="text-field" data-value="map"><option data-for="entry : map_options" data-attr-value="entry.value">{{entry.label}}</option></select></label><label class="testing-field">{{text[65]}}<input class="text-field text-field--numeric" type="text" data-value="x" maxlength="6"/></label><label class="testing-field">{{text[66]}}<input class="text-field text-field--numeric" type="text" data-value="y" maxlength="6"/></label><label class="testing-field">{{text[34]}}<input class="text-field text-field--numeric" type="text" data-value="radius" maxlength="6"/></label><label class="testing-field">{{text[35]}}<input class="text-field text-field--numeric" type="text" data-value="lifetime" maxlength="6"/></label><label class="testing-field">{{text[36]}}<input class="text-field text-field--numeric" type="text" data-value="level" maxlength="6"/></label><label class="testing-field">{{text[30]}}<select class="text-field" data-value="behavior"><option value="idle">{{text[31]}}</option><option value="wander">{{text[32]}}</option><option value="combat">{{text[33]}}</option></select></label></div>
            <div class="testing-actions"><div class="btn testing-button" data-event-click="testing_action('count_10')">10</div><div class="btn testing-button" data-event-click="testing_action('count_25')">25</div><div class="btn testing-button" data-event-click="testing_action('count_50')">50</div><div class="btn testing-button" data-event-click="testing_action('count_100')">100</div><div class="btn testing-button" data-class-disabled="busy || !administrator || !available" data-event-click="testing_action('crowd')">{{text[37]}}</div><div class="btn testing-button" data-class-disabled="busy || !administrator || !available" data-event-click="testing_action('remove_all')">{{text[38]}}</div></div>
            <p>{{text[41]}}</p><div class="testing-record" data-for="bot : bots">{{bot}}</div>
            <div class="testing-fields"><label class="testing-field">{{text[40]}}<input class="text-field" type="text" data-value="bot_name" maxlength="10"/></label></div><div class="testing-actions"><div class="btn testing-button" data-class-disabled="busy || !administrator || !available" data-event-click="testing_action('remove')">{{text[39]}}</div></div>
        </div>
        <div class="testing-page" data-class-active="tab == 4"><p>{{text[44]}}</p><div class="testing-actions"><div class="btn testing-button" data-class-disabled="busy" data-event-click="testing_action('market')">{{text[42]}}</div><div class="btn testing-button" data-class-disabled="busy" data-event-click="testing_action('shop')">{{text[43]}}</div></div></div>
        <div class="testing-page" data-class-active="tab == 5">
            <p>{{text[72]}}</p><div class="testing-summary">{{diagnostics}}</div>
            <p>{{text[73]}}</p><div class="testing-summary">{{server_metrics}}</div>
            <p>{{text[74]}}</p>
            <div class="testing-fields">
                <label class="testing-field">{{text[75]}}<input class="text-field text-field--numeric" type="text" data-value="damage_size" maxlength="3"/></label>
                <label class="testing-field">{{text[76]}}<select class="text-field" data-value="damage_weight"><option value="0">{{text[78]}}</option><option value="1">{{text[79]}}</option><option value="2">{{text[80]}}</option></select></label>
            </div>
            <div class="testing-actions"><div class="btn testing-button" data-event-click="testing_action('display')">{{text[77]}}</div></div>
            <p>{{text[53]}}</p><div class="testing-actions"><div class="btn testing-button" data-class-disabled="busy || !administrator || !available" data-event-click="testing_action('stop')">{{text[45]}}</div></div>
        </div>
    </div>
    <div class="testing-footer testing-actions"><div class="btn testing-button" data-class-disabled="!administrator || !available" data-event-click="testing_action('stop')">{{text[45]}}</div><div class="btn testing-button" data-class-disabled="busy" data-event-click="testing_action('refresh')">{{text[7]}}</div><div class="btn testing-button" data-class-disabled="busy" id="testing_close" data-event-click="testing_action('close')">{{text[8]}}</div></div>
</body>
</rml>
